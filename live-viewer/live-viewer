#!/usr/bin/env python3
"""live-viewer: live plot of a mudrarecord CSV stream read from stdin.

    mudrarecord stream-csv | live-viewer --width=5s
    mudrarecord stream-csv | live-viewer --width=5s --rms-packets=1
    mudrarecord stream-csv | live-viewer --width=5s --group='snc*' \
        --group='rms*' --group='a*' --shared-range-groups=1,2,3

Without --group: four panels on one time axis (seconds before the newest row): SNC raw
(snc1-3), SNC RMS (rms1-3), acc in g (ax, ay, az) and gyro in deg/s (gx, gy,
gz; shown once gyro rows arrive). Units use the nominal sensitivities; the y
axes are fixed to the full scale (SNC raw -32768..32767, RMS 0..32768, acc
±2 g, gyro ±250 deg/s).

With --group (upstream's options): one panel per --group, selecting value
columns by 1-based column numbers / ranges ('4-9', '1,3,5'), a wildcard on
the column names ('snc*', 'a*'), or rows by a channel token ('imu': rows
whose stream column is imu, with the columns that carry data in such rows
among the first 400 lines); raw CSV values. As upstream, each line of a
panel is scaled separately to 0-1 of the panel (y numbers hidden), except in
--shared-range-groups panels, which share one real range. Placement, gap breaks and min / max drawing are the same as below;
the SNC RMS smoothing (and --rms-packets) applies to the four-panel layout
only.

mudrarecord writes railed SNC samples (-32768 / +32767) as nan; when the CSV
has a raw_hex column the viewer reads their value from it, so railing is
drawn at the edge of the SNC raw panel (without raw_hex they are gaps).

Only the plotted columns are parsed (raw_hex only for rows with nan), and
lines are drawn without antialiasing. SNC raw is reduced to the min / max of
each pixel column (a dense band; peaks and railing stay visible), the other
lines to the min / max of PEAK_BINS bins. Parsing runs in its own thread, so
a slow frame lowers the frame rate but never delays reading stdin.

A signal is plotted only at rows where it has a value. The rows of one BLE
packet share its arrival time; SNC samples are spread evenly over the time
since the previous packet (over the median packet interval after a gap).
acc / gyro samples are placed on the device clock when the CSV has
device_ts: the 8 samples of a record evenly over the device-time interval
since the previous record (the timestamp is the last sample), mapped to host
time by a running linear fit of arrival time against device time; without
device_ts they are placed like SNC. SNC RMS shows the RMS over the last
--rms-packets packets' rms1-3 (display only; default RMS_PACKETS, 1 draws
each packet's values as upstream), one point per packet.
Consecutive samples more than 2x the median sample interval apart are not
connected.
"""
import argparse
import collections
import fnmatch
import itertools
import re
import signal
import statistics
import struct
import sys
import threading

import numpy as np

ACC_LSB_PER_G = 16384.0
GYRO_LSB_PER_DPS = 131.072
GAP_FACTOR = 2.0
INTERVAL_HISTORY = 50          # packet intervals in the running median
REDRAW_MS = 33
LINE_WIDTH = 2.5
RAW_LINE_WIDTH = 1             # SNC raw is a dense band; 1 px keeps a frame < 20 ms
AXIS_WIDTH = 70                # px, same for every panel so the time axes line up
PEAK_BINS = 400                # per curve: min and max of each bin are drawn
RMS_PACKETS = 6                # SNC RMS display: RMS over the last 6 packets (~100 ms)
FIT_RECORDS = 2000             # device-clock fit: last 2000 records (~10 s)
FIT_EVERY = 50                 # ... refitted every 50 records
FIT_MIN_SPAN_US = 1e6          # nominal 1 us ticks until the fit spans 1 s
DEVICE_TS_MODULUS = 1 << 32
# upstream's palette: 1 / x red, 2 / y blue, 3 / z green, then more for --group panels
COLOURS = [(200, 30, 30), (30, 90, 200), (30, 150, 60), (200, 130, 0), (140, 50, 190),
           (0, 150, 160), (190, 60, 140), (110, 100, 40), (60, 60, 60), (30, 170, 200),
           (150, 90, 30), (90, 120, 20)]
NON_VALUE_COLUMNS = {"timestamp_ns", "timestamp_iso", "stream", "raw_hex"}
SAMPLE_LINES = 400             # as upstream: lines read ahead to prune channel-token groups
SNC_RAW_COLUMNS = ("snc1", "snc2", "snc3")
IMU_COLUMNS = ("ax", "ay", "az", "gx", "gy", "gz")

# key, title, CSV columns (also the legend names), scale, one value per packet
PANELS = [
    ("raw", "SNC raw", ("snc1", "snc2", "snc3"), 1.0, False),
    ("snc", "SNC RMS", ("rms1", "rms2", "rms3"), 1.0, True),
    ("acc", "acc (g)", ("ax", "ay", "az"), 1 / ACC_LSB_PER_G, False),
    ("gyro", "gyro (deg/s)", ("gx", "gy", "gz"), 1 / GYRO_LSB_PER_DPS, False),
]
# fixed y ranges: the sensors' full scale
Y_RANGE = {"raw": (-32768, 32767), "snc": (0, 32768), "acc": (-2, 2), "gyro": (-250, 250)}


def parse_duration(text):
    m = re.fullmatch(r"\s*([0-9]*\.?[0-9]+)\s*(ms|s|m|h)?\s*", text)
    if not m:
        raise argparse.ArgumentTypeError(f"bad duration {text!r} (e.g. 500ms, 5s, 2m)")
    return float(m.group(1)) * {"ms": 1e-3, "s": 1.0, "m": 60.0, "h": 3600.0}[m.group(2) or "s"]


class DeviceClock:
    """Unwraps the u32 device timestamp and maps device ticks to host time
    with a running least-squares line over the last FIT_RECORDS records."""

    def __init__(self):
        self._raw = None
        self._value = 0
        self._dev = collections.deque(maxlen=FIT_RECORDS)
        self._host = collections.deque(maxlen=FIT_RECORDS)
        self._since = 0
        self.fit = None                            # (mean device, mean host, s per tick)

    def unwrap(self, raw):
        if self._raw is not None:
            d = (raw - self._raw) % DEVICE_TS_MODULUS
            self._value += d - DEVICE_TS_MODULUS if d >= DEVICE_TS_MODULUS // 2 else d
        else:
            self._value = raw
        self._raw = raw
        return self._value

    def add(self, dev, host):
        """One record: device time (unwrapped ticks) and host arrival (s)."""
        self._dev.append(dev)
        self._host.append(host)
        self._since += 1
        if self.fit is not None and self._since < FIT_EVERY:
            return
        self._since = 0
        d = np.array(self._dev, float)
        h = np.array(self._host, float)
        dm, hm = d.mean(), h.mean()
        slope = 1e-6
        if d.max() - d.min() >= FIT_MIN_SPAN_US:
            slope = float(np.sum((d - dm) * (h - hm)) / np.sum((d - dm) ** 2))
        self.fit = (dm, hm, slope)

    def to_host(self, dev):
        dm, hm, slope = self.fit
        return hm + (dev - dm) * slope


class Signal:
    """Samples of some CSV columns, (time, values), placed packet by packet
    (SNC) or record by record (acc / gyro on the device clock)."""

    def __init__(self, columns, scale, per_packet, keep_s, clock=None, smooth=0,
                 stream=None):
        self.columns = tuple(columns)
        self.stream = stream                       # only rows whose stream column equals this
        self.scale, self.per_packet, self.keep_s = scale, per_packet, keep_s
        self.clock = clock                         # set: acc / gyro, device_ts used if present
        self.smooth = smooth                       # SNC RMS panel: RMS over this many packets
        self.chunks = collections.deque()          # (times (n,), values (n, k), on device clock)
        self._group_key = None
        self._group_t = None
        self._group_dev = None
        self._group = []
        self._last = None
        self._intervals = collections.deque(maxlen=INTERVAL_HISTORY)
        self._recent = collections.deque(maxlen=smooth or 1)
        self.lock = threading.Lock()

    def add(self, t, values, dev=None):
        """One CSV row with values for this signal: arrival time t (s) and,
        for acc / gyro, the record's unwrapped device timestamp."""
        if self.clock is None:
            dev = None
        key = t if dev is None else ("dev", dev)
        if key != self._group_key:
            self.flush()
            self._group_key, self._group_t, self._group_dev = key, t, dev
        self._group.append(values)

    def flush(self):
        """Place the pending packet's (record's) samples in time."""
        if not self._group:
            return
        group, self._group = self._group, []
        on_device = self._group_dev is not None
        stamp = self._group_dev if on_device else self._group_t
        if on_device:
            self.clock.add(stamp, self._group_t)
        span = 0.0
        if self._last is not None and self._last[0] == on_device:
            span = stamp - self._last[1]
            normal = statistics.median(self._intervals) if self._intervals else span
            self._intervals.append(span)
            if span > GAP_FACTOR * normal:
                span = normal
        else:
            self._intervals.clear()
        self._last = (on_device, stamp)
        if self.per_packet:                        # RMS: one value per packet
            group = group[-1:]
        if self.smooth:
            self._recent.append(group[-1])
            r = np.array(self._recent, float)
            with np.errstate(invalid="ignore", divide="ignore"):
                group = [np.sqrt(np.nansum(r ** 2, axis=0) / np.sum(~np.isnan(r), axis=0))]
        n = len(group)
        times = stamp - span * (n - 1 - np.arange(n)) / n
        values = np.array(group, float) * self.scale
        keep = self.keep_s * (1e6 if on_device else 1.0)
        with self.lock:
            self.chunks.append((times, values, on_device))
            while self.chunks and self.chunks[0][0][-1] < stamp - keep:
                self.chunks.popleft()

    def arrays(self):
        """(host times in s (n,), values (n, k))."""
        with self.lock:
            chunks = list(self.chunks)
        if not chunks:
            return np.zeros(0), np.zeros((0, len(self.columns)))
        t = np.concatenate([c[0] for c in chunks])
        if self.clock is not None and self.clock.fit is not None:
            dev = np.concatenate([np.full(len(c[0]), c[2]) for c in chunks])
            if dev.any():
                t = np.where(dev, self.clock.to_host(t), t)
        return t, np.concatenate([c[1] for c in chunks])


def make_signals(keep_s, rms_packets=RMS_PACKETS):
    """Default layout: one Signal per panel; acc and gyro share one device clock."""
    clock = DeviceClock()
    return {key: Signal(cols, scale, per_packet, keep_s,
                        clock if key in ("acc", "gyro") else None,
                        smooth=rms_packets if key == "snc" else 0)
            for key, _, cols, scale, per_packet in PANELS}


def default_panels():
    """[{title, curves [(signal key, value index, legend name)], y_range, key}]"""
    return [{"key": key, "title": title, "y_range": Y_RANGE[key], "lazy": key == "gyro",
             "curves": [(key, i, c) for i, c in enumerate(cols)]}
            for key, title, cols, _, _ in PANELS]


def group_columns(spec, header, sample_rows=()):
    """(value columns, stream token or None) of one --group, as upstream:
    1-based column numbers / ranges ('4-9', '1,3,5'); a wildcard on the column
    names ('snc*'); otherwise a channel token ('imu'): rows whose stream column
    equals it, with the value columns that have data in such rows among the
    sample rows (all value columns if none match)."""
    values = [h for h in header if h not in NON_VALUE_COLUMNS]
    numbers = []
    for part in filter(None, (p.strip() for p in spec.split(","))):
        a, dash, b = part.partition("-")
        if not (a.isdigit() and (not dash or b.isdigit())):
            numbers = None
            break
        lo, hi = sorted((int(a), int(b))) if dash else (int(a), int(a))
        numbers += [header[i - 1] for i in range(lo, hi + 1) if 0 < i <= len(header)]
    if numbers is not None and numbers:
        return numbers, None                       # any column, as upstream
    if any(ch in spec for ch in "*?["):
        return [c for c in values if fnmatch.fnmatch(c, spec)], None
    if "stream" not in header:
        sys.exit(f"live-viewer: --group {spec!r}: a channel token needs a 'stream' column")
    si = header.index("stream")
    nonempty = {c for r in sample_rows if si < len(r) and r[si].strip() == spec
                for i, c in enumerate(header) if c in values and i < len(r) and r[i].strip()}
    return ([c for c in values if c in nonempty] if nonempty else values), spec


def group_layout(header, specs, keep_s, sample_rows=()):
    """--group mode: (signals, panels). One Signal per column (raw CSV values;
    rms per packet; acc / gyro columns on the device clock if device_ts exists);
    a channel-token group gets its own Signals that take only its rows."""
    clock = DeviceClock() if "device_ts" in header else None
    signals, panels = {}, []
    for spec in specs:
        cols, token = group_columns(spec, header, sample_rows)
        keys = [c if token is None else f"{token}:{c}" for c in cols]
        for key, c in zip(keys, cols):
            if key not in signals:
                signals[key] = Signal((c,), 1.0, c.startswith("rms"), keep_s,
                                      clock if c in IMU_COLUMNS else None, stream=token)
        panels.append({"key": spec, "title": spec, "y_range": None,
                       "curves": [(k, 0, c) for k, c in zip(keys, cols)]})
    return signals, panels


def shared_groups(text, n):
    """--shared-range-groups '1,3,4' -> 0-based panel indices."""
    out = set()
    for p in filter(None, (q.strip() for q in text.split(","))):
        if not p.isdigit() or not 1 <= int(p) <= n:
            sys.exit(f"live-viewer: --shared-range-groups: no group {p!r}")
        out.add(int(p) - 1)
    return out


def normalize(y):
    """As upstream for non-shared --group panels: map a line's visible
    [min, max] onto [0, 1]; a flat line is drawn at 0.5."""
    finite = y[np.isfinite(y)]
    if not finite.size:
        return y
    lo, hi = float(finite.min()), float(finite.max())
    return y - lo + 0.5 if hi <= lo else (y - lo) / (hi - lo)


def y_ranges(data, shared):
    """Autoscale: (lo, hi) per panel from its visible values; panels in
    `shared` get their common min / max. data: [list of value arrays]."""
    def span(arrays):
        v = np.concatenate([a[np.isfinite(a)] for a in arrays] or [np.zeros(0)])
        if not v.size:
            return None
        lo, hi = float(v.min()), float(v.max())
        return (lo - 1, hi + 1) if lo == hi else (lo, hi)
    out = [span(a) for a in data]
    common = span([a for i in shared for a in data[i]])
    return [common if i in shared else r for i, r in enumerate(out)]


def connect_mask(t):
    """pyqtgraph 'connect' array: False where the next sample is more than
    GAP_FACTOR x the median sample interval away."""
    if len(t) < 2:
        return np.zeros(len(t), bool)
    d = np.diff(t)
    return np.r_[d <= GAP_FACTOR * np.median(d), False]


def peak_decimate(x, y, conn, bins=PEAK_BINS):
    """Keep the min and the max of each of `bins` index bins (in time order),
    so peaks and railing stay visible; two kept points are connected only if
    no break lies between them. NaN never wins a bin unless the bin is all NaN."""
    n = len(x)
    if n <= 2 * bins:
        return x, y, conn
    k = -(-n // bins)
    m = n // k * k
    lo = np.where(np.isnan(y[:m]), np.inf, y[:m]).reshape(-1, k).argmin(axis=1)
    hi = np.where(np.isnan(y[:m]), -np.inf, y[:m]).reshape(-1, k).argmax(axis=1)
    base = np.arange(0, m, k)
    idx = np.sort(np.r_[base + lo, base + hi, np.arange(m, n)])
    breaks = np.r_[0, np.cumsum(~conn[:-1])]          # breaks before each sample
    return x[idx], y[idx], np.r_[breaks[idx[1:]] == breaks[idx[:-1]], False]


class Reader(threading.Thread):
    """Parses CSV lines into the panels' signals."""

    def __init__(self, stream, header, signals):
        super().__init__(daemon=True)
        self.stream = stream
        idx = {name: i for i, name in enumerate(header)}
        if "timestamp_ns" not in idx:
            sys.exit("live-viewer: no timestamp_ns column in the CSV header")
        self.ts_col = idx["timestamp_ns"]
        cols = {key: [idx[c] for c in s.columns] for key, s in signals.items()
                if all(c in idx for c in s.columns)}
        # parse only from the first plotted column to the end of the line
        # (skips raw_hex and the other leading columns)
        self.first = min(min(c) for c in cols.values()) if cols else len(header)
        self.n_tail = len(header) - self.first
        self.cols = {key: [c - self.first for c in cs] for key, cs in cols.items()}
        self.raw_col = idx.get("raw_hex")
        dts = idx.get("device_ts")
        self.dev_col = dts - self.first if dts is not None and dts >= self.first else None
        snc = idx.get("snc1")
        self.snc_col = snc - self.first if snc is not None and snc >= self.first else None
        self.stream_col = idx.get("stream") if any(s.stream for s in signals.values()) else None
        self.snc_chans = {key: [SNC_RAW_COLUMNS.index(c) for c in s.columns]
                          for key, s in signals.items()
                          if key in self.cols and set(s.columns) <= set(SNC_RAW_COLUMNS)}
        self._snc_ts, self._snc_row = None, 0     # current SNC packet, row within it
        self._decoded = (None, ())                # (timestamp, its 54 raw values)
        self.signals = signals
        self.latest = None

    def _railed(self, line, ts, k):
        """[snc1, snc2, snc3] of row k of this packet from raw_hex (the CSV
        has nan for railed samples), or None without raw_hex."""
        if self.raw_col is None:
            return None
        if self._decoded[0] != ts:
            try:
                raw = bytes.fromhex(line.split(",", self.raw_col + 1)[self.raw_col])
                self._decoded = (ts, struct.unpack_from("<54h", raw))
            except (ValueError, struct.error):
                self._decoded = (ts, ())
        vals = self._decoded[1]
        return [float(v) for v in vals[3 * k:3 * k + 3]] if 3 * k + 3 <= len(vals) else None

    def feed(self, line):
        line = line.rstrip("\r\n")
        if self.ts_col == 0:
            ts = line[:line.find(",")]
        else:
            ts = line.split(",", self.ts_col + 1)[self.ts_col]
        try:
            t = int(ts) / 1e9
        except ValueError:
            return
        if self.first == 0:
            f = line.split(",")
        else:
            f = line.rsplit(",", self.n_tail)[1:] if self.n_tail else []
        row_stream = None
        if self.stream_col is not None:
            parts = line.split(",", self.stream_col + 1)
            row_stream = parts[self.stream_col].strip() if self.stream_col < len(parts) else None
        if self.snc_chans and self.snc_col is not None and self.snc_col < len(f) and f[self.snc_col]:
            if ts != self._snc_ts:                 # row number within its SNC packet
                self._snc_ts, self._snc_row = ts, 0
            else:
                self._snc_row += 1
        for key, cols in self.cols.items():
            if self.signals[key].stream is not None and self.signals[key].stream != row_stream:
                continue
            cells = [f[c] if c < len(f) else "" for c in cols]
            if all(cells):
                try:
                    values = [float(c) for c in cells]
                except ValueError:
                    continue
                if key in self.snc_chans and "nan" in cells:
                    full = self._railed(line, ts, self._snc_row)
                    if full:
                        values = [full[c] for c in self.snc_chans[key]]
                dev = None
                clock = self.signals[key].clock
                if clock is not None and self.dev_col is not None:
                    cell = f[self.dev_col] if self.dev_col < len(f) else ""
                    if cell:
                        dev = clock.unwrap(int(cell))
                self.signals[key].add(t, values, dev)
        self.latest = t if self.latest is None else max(self.latest, t)

    def run(self):
        for line in self.stream:
            self.feed(line)
        for s in self.signals.values():
            s.flush()


def run_gui(reader, signals, width, panels=None, shared=frozenset()):
    """panels: default_panels() (fixed full-scale y axes) or group_layout()
    panels (each line scaled to 0-1, as upstream; panels whose index is in
    `shared` share one real range)."""
    import pyqtgraph as pg
    from pyqtgraph.Qt import QtCore, QtWidgets

    panels = panels or default_panels()
    pg.setConfigOptions(antialias=False, background="w", foreground="k")
    app = pg.mkQApp("live-viewer")
    win = pg.GraphicsLayoutWidget(title="live-viewer")
    win.resize(1100, max(750, 190 * len(panels)))
    win.ci.layout.setColumnFixedWidth(1, 70)      # legend column, outside the plots
    plots = {}                                    # panel index -> (plot, [(curve, signal, index)])

    def add_panel(row):
        panel = panels[row]
        plot = win.addPlot(row=row, col=0, title=panel["title"])
        plot.showGrid(x=True, y=True, alpha=0.2)
        plot.getAxis("left").setWidth(AXIS_WIDTH)
        plot.setXRange(-width, 0, padding=0)
        plot.setMouseEnabled(x=False, y=False)
        plot.disableAutoRange()
        if panel["y_range"] is not None:
            plot.setYRange(*panel["y_range"], padding=0)
        elif row not in shared:                   # as upstream: each line scaled to 0-1,
            plot.setYRange(0.0, 1.0, padding=0.02)    # so the y numbers mean nothing
            plot.getAxis("left").setStyle(showValues=False)
        if plots:
            plot.setXLink(plots[min(plots)][0])
        legend = pg.LegendItem()
        fixed = QtWidgets.QSizePolicy.Policy.Fixed
        legend.setSizePolicy(fixed, fixed)         # compact, not stretched to the panel
        win.addItem(legend, row=row, col=1)
        curves = []
        for (key, i, name), colour in zip(panel["curves"], COLOURS * 4):
            raw = signals[key].columns[i] in SNC_RAW_COLUMNS
            c = plot.plot(pen=pg.mkPen(colour, width=RAW_LINE_WIDTH if raw else LINE_WIDTH))
            legend.addItem(pg.PlotDataItem(pen=pg.mkPen(colour, width=3)), name)
            curves.append((c, key, i, raw))
        for p, _ in plots.values():               # time labels on the bottom panel only
            p.getAxis("bottom").setStyle(showValues=False)
            p.setLabel("bottom", "")
        if row == max([*plots, row]):
            plot.setLabel("bottom", "time (s)")
        else:
            plot.getAxis("bottom").setStyle(showValues=False)
        plots[row] = (plot, curves)

    for row, panel in enumerate(panels):
        if not panel.get("lazy"):                 # default layout: gyro once gyro rows arrive
            add_panel(row)

    def redraw():
        if reader.latest is None:
            return
        for row, panel in enumerate(panels):
            if row not in plots and signals[panel["curves"][0][0]].chunks:
                add_panel(row)
        cache, data = {}, {}
        for row, (plot, curves) in sorted(plots.items()):
            data[row] = []
            for curve, key, i, raw in curves:
                if key not in cache:
                    t, v = signals[key].arrays()
                    x = t - reader.latest
                    keep = x >= -width
                    cache[key] = (x[keep], v[keep], connect_mask(x[keep]))
                x, v, conn = cache[key]
                # SNC raw: one min / max pair per pixel column (a dense band)
                bins = max(1, int(plot.getViewBox().width())) if raw else PEAK_BINS
                xd, yd, cd = peak_decimate(x, v[:, i], conn, bins)
                if panels[row]["y_range"] is None and row not in shared:
                    yd = normalize(yd)
                curve.setData(xd, yd, connect=cd)
                data[row].append(yd)
        common = [r for r in sorted(plots) if r in shared and panels[r]["y_range"] is None]
        if common:                                # --shared-range-groups: one real range
            rng = y_ranges([data[r] for r in common], set(range(len(common))))[0]
            if rng is not None:
                for r in common:
                    plots[r][0].setYRange(*rng, padding=0.05)

    timer = QtCore.QTimer()
    timer.timeout.connect(redraw)
    timer.start(REDRAW_MS)
    win.show()
    return app, win, timer


def main(argv=None):
    ap = argparse.ArgumentParser(prog="live-viewer", description=__doc__.split("\n")[0])
    ap.add_argument("--width", type=parse_duration, default=5.0,
                    help="time window shown, e.g. 500ms, 5s, 2m (default 5s)")
    ap.add_argument("--group", action="append", default=[],
                    help="one panel per --group, as upstream: 1-based column numbers / "
                         "ranges ('4-9', '1,3,5'), a wildcard on the column names "
                         "('snc*', 'a*') or a channel token selecting rows by their "
                         "stream column ('imu'); each line scaled to 0-1 unless shared. "
                         "Without --group: the "
                         "four fixed panels.")
    ap.add_argument("--shared-range-groups", default="",
                    help="comma-separated 1-based indices of --group panels that share "
                         "one y range, e.g. '1,2,3'")
    ap.add_argument("--rms-packets", type=int, default=None, metavar="N",
                    help="SNC RMS panel: RMS over the last N packets' rms1-3 "
                         f"(default {RMS_PACKETS}, ~100 ms); 1 draws each packet's "
                         "values as upstream. Not with --group.")
    args = ap.parse_args(argv)
    if args.rms_packets is not None and args.group:
        ap.error("--rms-packets applies to the four-panel layout only, not with --group")
    if args.rms_packets is None:
        args.rms_packets = RMS_PACKETS
    if args.rms_packets < 1:
        ap.error("--rms-packets must be an integer >= 1")
    header = sys.stdin.readline().rstrip("\r\n").split(",")
    stream = sys.stdin
    if args.group:                             # as upstream: sample rows read ahead, then replayed
        sample = [sys.stdin.readline() for _ in range(SAMPLE_LINES - 1)]
        sample = [ln for ln in sample if ln]
        stream = itertools.chain(sample, sys.stdin)
        rows = [ln.rstrip("\r\n").split(",") for ln in sample]
        signals, panels = group_layout(header, args.group, args.width + 1.0, rows)
        shared = shared_groups(args.shared_range_groups, len(panels))
    else:
        signals = make_signals(args.width + 1.0, args.rms_packets)
        panels, shared = default_panels(), set()
    reader = Reader(stream, header, signals)
    reader.start()
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app, _win, _timer = run_gui(reader, signals, args.width, panels, shared)
    app.exec()


if __name__ == "__main__":
    main()
